<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Палітра світлої теми -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E2E6EE"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1B1F29"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#667085"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3ECFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="InputBrush" Color="#F7F8FB"/>
    <SolidColorBrush x:Key="IncomeBrush" Color="#059669"/>
    <SolidColorBrush x:Key="ExpenseBrush" Color="#DC2626"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1B1F29"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1B1F29"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2563EB"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#DCE6FB"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B1F29"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#98A2B3"/>
</ResourceDictionary>
