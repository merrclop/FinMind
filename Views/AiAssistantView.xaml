<UserControl x:Class="FinMind.Views.AiAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PanningMode="Both">
        <StackPanel Margin="28,24,28,28" MinWidth="620">

            <StackPanel Margin="0,0,0,20">
                <TextBlock Style="{StaticResource H1}" Text="ШІ-Асистент"/>
                <TextBlock Style="{StaticResource Subtle}" Text="Сканування чеків та персональні поради на базі Google Gemini"/>
            </StackPanel>

            <!-- ═════════ Сканер чеків ═════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="📷 Сканер чеків"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,14"
                               Text="Завантажте фото чека (або перетягніть файл у це вікно) — Gemini Vision визначить суму, магазин, категорію та дату."/>
                    <Button Content="📷  Завантажити фото чека" Command="{Binding PickAndScanCommand}" HorizontalAlignment="Left"/>
                    <ProgressBar IsIndeterminate="True" Margin="0,14,0,0"
                                 Visibility="{Binding IsScanBusy, Converter={StaticResource BoolVis}}"/>

                    <Grid Margin="0,16,0,0" Visibility="{Binding Preview, Converter={StaticResource NullVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,10,0">
                            <Image Source="{Binding Preview}" MaxHeight="380" Stretch="Uniform"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                    Visibility="{Binding HasScanResult, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Сума"/>
                            <TextBox Text="{Binding ScanAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Магазин / опис"/>
                            <TextBox Text="{Binding ScanStore, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Категорія"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding ScanCategory}" Margin="0,0,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji, Segoe UI" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Дата"/>
                            <DatePicker SelectedDate="{Binding ScanDate}" Margin="0,0,0,16"/>
                            <WrapPanel>
                                <Button Content="💾  Зберегти в базу" Command="{Binding SaveReceiptCommand}" Margin="0,0,10,8"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Скасувати"
                                        Command="{Binding DiscardScanCommand}" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═════════ Фінансовий радник ═════════ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="🧠 Фінансовий радник"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,14"
                               Text="Аналіз ваших доходів і витрат за останні 30 днів: 3–4 практичні поради щодо економії та перевитрат."/>
                    <Button Content="🧠  Отримати аналіз бюджету" Command="{Binding GetAdviceCommand}" HorizontalAlignment="Left"/>
                    <ProgressBar IsIndeterminate="True" Margin="0,14,0,0"
                                 Visibility="{Binding IsAdviceBusy, Converter={StaticResource BoolVis}}"/>

                    <Border Margin="0,16,0,0" Padding="16" CornerRadius="10"
                            Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding HasAdvice, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding AdviceText}" TextWrapping="Wrap" LineHeight="22"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
