<UserControl x:Class="FinMind.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PanningMode="Both">
        <StackPanel Margin="28,24,28,28" MinWidth="560" MaxWidth="820" HorizontalAlignment="Left">

            <StackPanel Margin="0,0,0,20">
                <TextBlock Style="{StaticResource H1}" Text="Налаштування"/>
                <TextBlock Style="{StaticResource Subtle}" Text="Ключ Gemini, валюта, тема та масштаб інтерфейсу"/>
            </StackPanel>

            <ProgressBar IsIndeterminate="True" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>

            <!-- Gemini -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="🔑 Google Gemini"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,14">
                        <Run Text="Ключ зберігається локально у settings.json. Отримати безкоштовний ключ можна у"/>
                        <Hyperlink NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="OnLinkClick">Google AI Studio</Hyperlink><Run Text="."/>
                    </TextBlock>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="API ключ"/>
                    <Grid Margin="0,0,0,10">
                        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ShowApiKey, Converter={StaticResource BoolVis}}"/>
                        <PasswordBox x:Name="KeyBox" PasswordChanged="OnPasswordChanged"
                                     Visibility="{Binding ShowApiKey, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                    </Grid>
                    <CheckBox Content="Показати ключ" IsChecked="{Binding ShowApiKey}" Margin="0,0,0,14"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Модель (наприклад, gemini-2.5-flash)"/>
                    <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <Button Style="{StaticResource SecondaryButton}" Content="🔌  Перевірити з'єднання"
                            Command="{Binding TestConnectionCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Вигляд -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="🎨 Вигляд і валюта"/>
                    <WrapPanel Margin="0,14,0,0">
                        <StackPanel Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Базова валюта"/>
                            <ComboBox Width="180" ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Тема"/>
                            <ComboBox Width="180" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Масштаб інтерфейсу"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="60" Maximum="250" LargeChange="10" SmallChange="5"
                                IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"
                                Value="{Binding UiScalePercent, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="14,0" MinWidth="48"
                                   Text="{Binding UiScalePercent, StringFormat={}{0:0}%}"/>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="100%"
                                Command="{Binding ResetZoomCommand}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,10,0,0" FontSize="12"
                               Text="Жести: Ctrl + колесо миші, щипок на тачпаді або двома пальцями на сенсорному екрані. Клавіші: Ctrl + «+», Ctrl + «−», Ctrl + 0; Ctrl + 1…4 — перехід між розділами."/>
                </StackPanel>
            </Border>

            <!-- Дані -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="🗄 Дані програми"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,12" Text="{Binding StoragePath}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="📂  Відкрити папку з даними"
                            Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Button Content="💾  Зберегти налаштування" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
